{
  "name": "@sust-reg/web",
  "version": "0.0.0",
  "private": true,
  "description": "React + TypeScript web application (ADR-0021): the primary human surface. Built with webpack and prerendered to static HTML so it stays indexable (ADR-0013) and Always-Free to host (ADR-0016).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "webpack --config webpack.config.cjs && node build/prerender.cjs",
    "clean": "rm -rf dist build"
  },
  "dependencies": {
    "@sust-reg/core": "*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "ts-loader": "^9.6.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  }
}
